# Salin jadi .env lalu sesuaikan (atau export manual di shell).
# Server tidak membaca file .env otomatis — pakai:  set -a; . ./.env; set +a

# --- dasar ---
PORT=8787
HOST=0.0.0.0
STATIC_ROOT=../ism-site

# --- kredensial upload ---
# Kalau diisi, user yang membuka halaman TIDAK perlu mengisi kunci sendiri.
# Batasi kunci ini ke API "Assets" dengan operasi Read + Write saja.
ROBLOX_API_KEY=

# WAJIB kalau server ini bisa diakses orang lain.
ACCESS_PASSWORD=
# Biarkan kosong untuk acak (sesi hilang saat restart).
SESSION_SECRET=

# --- OAuth 2.0 (opsional; mengaktifkan tombol login) ---
ROBLOX_OAUTH_CLIENT_ID=
ROBLOX_OAUTH_CLIENT_SECRET=
# OAUTH_REDIRECT_URI=https://domainmu.example/api/oauth/callback

# --- batas & perilaku ---
CONCURRENCY=3
MAX_ITEMS=120
JOB_RATE_LIMIT=10

# --- CORS (kalau UI di-host di domain lain) ---
# ALLOWED_ORIGINS=https://ism.example,https://user.github.io

# --- khusus pengujian / mirror CDN. Jangan diisi sembarangan di produksi. ---
# ALLOW_ASSET_HOSTS=127.0.0.1
# ROBLOX_APIS_BASE=https://apis.roblox.com
# ROBLOX_ASSET_DELIVERY_BASE=https://assetdelivery.roblox.com
# ROBLOX_OAUTH_BASE=https://apis.roblox.com/oauth/v1
